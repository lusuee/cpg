{
  "name": "cloudflare-personal-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare-native personal AI Gateway (V1 MVP)",
  "scripts": {
    "build:web": "node scripts/prepare-config.mjs && pnpm --filter @aigw/web build",
    "dev:worker": "pnpm --filter @aigw/worker dev",
    "dev:web": "pnpm --filter @aigw/web dev",
    "dev": "pnpm run build:web && pnpm run dev:worker",
    "deploy": "node scripts/deploy.mjs",
    "test": "pnpm --filter @aigw/worker test",
    "typecheck": "pnpm --filter @aigw/worker typecheck && pnpm --filter @aigw/web typecheck",
    "db:migrate:local": "pnpm --filter @aigw/worker db:migrate:local",
    "deploy:worker": "pnpm --filter @aigw/worker deploy",
    "db:migrate:remote": "pnpm --filter @aigw/worker db:migrate:remote"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@11.19.0"
}
