# Copy this file to deploy.env and fill in values (deploy.env is gitignored)
#
# D1 Database ID（可选）：留空时部署脚本会自动创建 personal-ai-gateway 数据库并自动注入 ID
# 若已有数据库，可填入其 ID
# D1_DATABASE_ID=

# Admin login password and session signing key (required)
ADMIN_SECRET=change-me
SESSION_SECRET=generate-a-long-random-string

# Gateway base URL shown on Dashboard, e.g. https://ai.example.com
# GATEWAY_BASE_URL=https://ai.example.com
# APP_NAME=Personal AI Gateway

# Upstream provider keys, fill as needed
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
