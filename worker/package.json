{
  "name": "@aigw/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "node ../scripts/prepare-config.mjs && pnpm --filter @aigw/web build",
    "build:web": "node ../scripts/prepare-config.mjs && pnpm --filter @aigw/web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply personal-ai-gateway --local",
    "db:migrate:remote": "wrangler d1 migrations apply personal-ai-gateway --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^3.86.0"
  }
}
